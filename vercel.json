{
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/mesa", "destination": "/admin.html" },
    { "source": "/club", "destination": "/club.html" },
    { "source": "/guia", "destination": "/guia.html" },
    { "source": "/guia-padres", "destination": "/guia-padres.html" },
    { "source": "/guia-organizador", "destination": "/guia-organizador.html" },
    { "source": "/verificar", "destination": "/verificar.html" },
    { "source": "/jugador", "destination": "/jugador.html" },
    { "source": "/jugador/:token", "destination": "/api/jugador?token=:token" },
    { "source": "/(.*)", "destination": "/index.html" }
